# Astro Player Configuration Settings

# Server Port
PORT=5000

# Security Secrets
JWT_SECRET=your_jwt_secret_token_here

# YouTube API Integration (Credential from official dashboard)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database URL (Optional: Leave empty to automatically fallback to local SQLite)
# For PostgreSQL: postgresql://username:password@localhost:5432/astro_player
DATABASE_URL=
